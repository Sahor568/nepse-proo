# .env.example - template for required env vars
# Copy this to .env and replace placeholder values with real secrets.

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://nepse-pro.vercel.app/auth/google/callback

# JWT secret (Render can generate one)
JWT_SECRET=YOUR_RANDOM_JWT_SECRET

# Server configuration (local dev)
PORT=5000

# Gmail SMTP
EMAIL_FROM=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_HOST=smtp.gmail.com
# Port 587 is tried first; if it times out, the code retries with 465 over TLS.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=30000

FRONTEND_URL=https://nepse-pro.vercel.app

# Vite/Vercel variables (must be prefixed with VITE_)
VITE_API_URL=http://localhost:5000/api

